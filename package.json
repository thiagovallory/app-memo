{
  "name": "app-memo",
  "version": "0.1.0",
  "description": "Nuvem de memórias: fotos e vídeos de uma pasta em uma tela touch.",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "kiosk": "electron . --kiosk",
    "dist": "electron-builder",
    "test": "node --test test/*.test.mjs",
    "ios:setup": "sh scripts/ios-setup.sh",
    "ios:sync": "cap sync ios",
    "ios:open": "cap open ios",
    "test:web": "node test/e2e/web.mjs"
  },
  "devDependencies": {
    "@capacitor-community/keep-awake": "^8.0.1",
    "@capacitor/cli": "^8.5.3",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/status-bar": "^8.0.4",
    "electron": "^44.9.0",
    "electron-builder": "^26.15.3",
    "playwright-core": "^1.64.1"
  },
  "build": {
    "appId": "com.thiagovallory.appmemo",
    "productName": "Memo",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis"
    },
    "mac": {
      "target": "dmg"
    },
    "linux": {
      "target": "AppImage"
    }
  },
  "private": true
}
